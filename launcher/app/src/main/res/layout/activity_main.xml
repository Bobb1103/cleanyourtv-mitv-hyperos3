<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden). -->
    <com.gathin.tvhome.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Cinematic top shelf (cinematic_home): the focused dock app's artwork, a few pixels across and
         stretched over the screen, which softens it like a blur without the cost of one. Hidden otherwise. -->
    <ImageView
        android:id="@+id/heroArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Race-weekend panel (a theme's race_calendar, see RaceWeekend): in the free space under the clock,
         shown only from shortly before a weekend's first session until the race is over. Updated once a
         minute with the clock, never animated. -->
    <LinearLayout
        android:id="@+id/racePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginStart="60dp"
        android:layout_marginTop="158dp"
        android:orientation="vertical"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- A short kerb-red bar, the panel's one accent. -->
            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/race_bar" />

            <TextView
                android:id="@+id/raceKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.22"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/raceHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.01"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/raceSessions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.12" />
    </LinearLayout>


    <!-- Cinematic top shelf: darkens the edge behind the shelf and the lower half, so the text and the
         dock stay readable over the artwork. -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Top shelf: the focused dock app's name, positioned above the dock in code. -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="68dp"
        android:orientation="vertical"
        android:alpha="0">

        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="48sp"
            android:fontFamily="@string/font_light"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <!-- Cinematic shelf only: when the app was last opened, and the dock position dots. -->
        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="15sp"
            android:fontFamily="@string/font_light"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/heroDots"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginStart="4dp"
            android:layout_marginTop="16dp"
            android:orientation="horizontal"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Habit calendar (config.xml habit_calendar, see HabitPanel): the days as pixel squares, seven to
         a row, Monday first, and no text anywhere. Two pages while the panel holds the cursor, swapped
         between with the left and right keys: the month, and today's weight with the curve of the run
         so far. OK ticks today on the month page, which is drawn like any other day and only grows a
         little under the cursor. A child of the root frame, not of the shelf's layout, so it floats
         over the top strip of the first row of tiles instead of pushing the grid down: the shelf, the
         grid and the dock stay exactly where they were.

         The left column is a fixed box (HabitPanel sizes the rows to six weeks) so neither page nor
         any long month can move the panel; the figure on the right is drawn from the newest weight.

         Placed before the layout that holds the grid and the dock, so both are drawn over it: a tile
         scrolled up into its patch of screen covers the panel, and no half-covered calendar is ever
         left lying on top of the apps. HabitPanel fades it out the moment the cursor leaves the
         dock's row, so the two are never on top of each other for longer than the fade takes. -->
    <LinearLayout
        android:id="@+id/habitPanel"
        android:layout_width="406dp"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginStart="60dp"
        android:layout_marginTop="112dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp"
        android:background="@drawable/habit_panel_bg"
        android:focusable="true"
        android:clickable="true"
        android:nextFocusUp="@+id/btnSettings"
        android:nextFocusDown="@+id/grid"
        android:nextFocusRight="@+id/grid"
        android:visibility="gone">

        <FrameLayout
            android:layout_width="253dp"
            android:layout_height="192dp">

            <LinearLayout
                android:id="@+id/habitGrid"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_vertical"
                android:orientation="vertical" />

            <LinearLayout
                android:id="@+id/weightPage"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:visibility="gone">

                <!-- Start, latest and goal weights. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/habit_weight_start_label"
                            android:textColor="#8A948D"
                            android:textSize="8sp" />

                        <TextView
                            android:id="@+id/weightStart"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@string/font_pixel"
                            android:includeFontPadding="false"
                            android:textColor="#E6E6E6"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/habit_weight_now_label"
                            android:textColor="#8A948D"
                            android:textSize="8sp" />

                        <TextView
                            android:id="@+id/weightNow"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@string/font_pixel"
                            android:includeFontPadding="false"
                            android:textColor="#97C459"
                            android:textSize="12sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/habit_weight_goal_label"
                            android:textColor="#8A948D"
                            android:textSize="8sp" />

                        <TextView
                            android:id="@+id/weightGoal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@string/font_pixel"
                            android:includeFontPadding="false"
                            android:textColor="#8A948D"
                            android:textSize="12sp" />
                    </LinearLayout>
                </LinearLayout>

                <com.gathin.tvhome.WeightChartView
                    android:id="@+id/weightChart"
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="4dp"
                    android:layout_marginBottom="4dp" />

                <!-- Today's weight: up and down move it by habit_weight_step, OK records it. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/weightInput"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingStart="12dp"
                        android:paddingEnd="12dp"
                        android:paddingTop="5dp"
                        android:paddingBottom="5dp"
                        android:background="@drawable/habit_weight_input_bg"
                        android:focusable="true"
                        android:nextFocusUp="@+id/habitPanel"
                        android:nextFocusDown="@+id/grid">

                        <TextView
                            android:id="@+id/weightDraft"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:fontFamily="@string/font_pixel"
                            android:includeFontPadding="false"
                            android:textColor="#F0A03C"
                            android:textSize="15sp" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:text="@string/habit_weight_unit"
                        android:textColor="#F0A03C"
                        android:textSize="9sp" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/weightEditHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/habit_weight_edit"
                            android:textColor="#9FB0A4"
                            android:textSize="8sp" />

                        <TextView
                            android:id="@+id/weightSaveHint"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/habit_weight_save"
                            android:textColor="#9FB0A4"
                            android:textSize="8sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </FrameLayout>

        <Space
            android:layout_width="21dp"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="96dp"
            android:layout_height="wrap_content"
            android:gravity="center_horizontal"
            android:orientation="vertical">

            <TextView
                android:id="@+id/habitStreak"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#C0DD97"
                android:textSize="9sp"
                android:visibility="gone" />

            <com.gathin.tvhome.PixelBodyView
                android:id="@+id/habitBody"
                android:layout_width="96dp"
                android:layout_height="156dp"
                android:layout_marginTop="4dp" />

            <TextView
                android:id="@+id/weightLevel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="#F0A03C"
                android:textSize="9sp"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- No clipping down to the pills: with advanced effects a focused pill scales up past its row. -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <LinearLayout
                android:id="@+id/leftBlock"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/topButtons"
                android:layout_marginEnd="16dp"
                android:orientation="vertical">

                <!-- The header texts use gravity left, not start: the launcher lays out left to right
                     (no supportsRtl), and with start a right-to-left script such as Arabic would move to the
                     right edge of these full-width lines instead of staying under the clock. -->
                <TextView
                    android:id="@+id/greeting"
                    android:gravity="left"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:layout_marginStart="4dp"
                    android:textColor="#8CFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@string/font_medium"
                    android:letterSpacing="0.22"
                    android:textAllCaps="true" />

                <!-- The date sits above the clock, both lines in the pixel face. TextClock would localise
                     the weekday and month names (Chinese on a zh TV), so the date is a plain TextView
                     whose text MainActivity sets from code each minute, fixed English. -->
                <TextView
                    android:id="@+id/date"
                    android:gravity="left"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:layout_marginBottom="9dp"
                    android:singleLine="true"
                    android:textColor="#9FB0A4"
                    android:textSize="13sp"
                    android:fontFamily="@string/font_pixel"
                    android:letterSpacing="0.06"
                    android:includeFontPadding="false"
                    android:textAllCaps="true"
                    android:importantForAccessibility="no" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="true">

                    <!-- The pixel face (Press Start 2P) is a monospace: every glyph is a full em wide, so
                         the clock is set smaller than the Outfit one was, or "21:31" would push the date
                         and the pills off the shelf. The pixel grid also reads better with the glyphs
                         spaced a little, so the tracking goes the other way too. -->
                    <TextClock
                        android:id="@+id/clock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:format12Hour="h:mm"
                        android:format24Hour="HH:mm"
                        android:textColor="#FFFFFFFF"
                        android:textSize="34sp"
                        android:fontFamily="@string/font_pixel"
                        android:letterSpacing="0.06"
                        android:includeFontPadding="false" />

                    <TextClock
                        android:id="@+id/ampm"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="8dp"
                        android:format12Hour="a"
                        android:format24Hour=""
                        android:textColor="#B3FFFFFF"
                        android:textSize="15sp"
                        android:fontFamily="@string/font_medium"
                        android:letterSpacing="0.08"
                        android:textAllCaps="true" />

                    <View
                        android:id="@+id/clockDivider"
                        android:layout_width="1dp"
                        android:layout_height="26dp"
                        android:layout_gravity="bottom"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="16dp"
                        android:layout_marginBottom="8dp"
                        android:background="#33FFFFFF" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_weight="1"
                        android:layout_height="wrap_content"
                        android:layout_gravity="bottom"
                        android:layout_marginBottom="9dp"
                        android:orientation="vertical">

                        <!-- Shamsi date ("27 Mehr 1405"), shown when shamsi_date is on. -->
                        <TextView
                            android:id="@+id/shamsiDate"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#E6FFFFFF"
                            android:textSize="17sp"
                            android:fontFamily="@string/font_regular"
                            android:letterSpacing="0.02"
                            android:includeFontPadding="false"
                            android:visibility="gone" />

                        <!-- Lunar date ("Lunar 13/9 · Year of the Horse"), shown when lunar_date is on. -->
                        <TextView
                            android:id="@+id/lunarDate"
                            android:gravity="left"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:singleLine="true"
                            android:ellipsize="end"
                            android:textColor="#80FFFFFF"
                            android:textSize="14sp"
                            android:fontFamily="@font/outfit_regular"
                            android:letterSpacing="0.14"
                            android:textAllCaps="true"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <!-- Shown only when show_stats is on. Outside leftBlock, so the top buttons stay level with the clock
                 row; gone, it takes no space. -->
            <TextView
                android:id="@+id/stats"
                android:layout_width="wrap_content"
                android:layout_below="@id/leftBlock"
                android:layout_alignStart="@id/leftBlock"
                android:gravity="left"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:singleLine="true"
                android:ellipsize="end"
                android:textColor="#D9FFFFFF"
                android:textSize="14sp"
                android:fontFamily="@string/font_medium"
                android:letterSpacing="0.04"
                android:focusable="false"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBottom="@id/leftBlock"
                android:layout_marginBottom="6dp"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:orientation="horizontal">

                <!-- Label only, no icon: the top bar reads as three words (see TOP_BUTTON_TEXT_ONLY). -->
                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButton"
                    android:text="@string/inputs"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButton"
                    android:maxWidth="180dp"
                    android:singleLine="true"
                    android:ellipsize="end"
                    android:text="@string/wifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnReorder"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/reorder"
                    android:drawableStart="@drawable/ic_swap_vert"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnLibraryTop"
                    style="@style/TopButtonIcon"
                    android:visibility="gone"
                    android:contentDescription="@string/app_library"
                    android:drawableStart="@drawable/ic_apps_pill"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButton"
                    android:text="@string/settings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.gathin.tvhome.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />

</FrameLayout>

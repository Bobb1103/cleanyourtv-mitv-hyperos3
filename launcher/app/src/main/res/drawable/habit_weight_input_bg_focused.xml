<?xml version="1.0" encoding="utf-8"?>
<!-- The same slab with the cursor on it: brighter fill, lit edge, so up and down know where they land. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#661C3324" />
    <stroke
        android:width="1.5dp"
        android:color="#F0A03C" />
    <corners android:radius="8dp" />
</shape>

<?xml version="1.0" encoding="utf-8"?>
<!-- The habit calendar's plate: no fill at all, so the home wallpaper shows straight through and only
     the days float over it. The hairline edge is what is left of the plate and it is what keeps the
     rounded corners reading as the same shape as a banner tile. The focused state is
     habit_panel_bg_focused: same transparent plate, brighter edge, since the panel is one focus stop
     and must show when it has the cursor. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@android:color/transparent" />
    <stroke
        android:width="1dp"
        android:color="#14FFFFFF" />
    <corners android:radius="16dp" />
</shape>

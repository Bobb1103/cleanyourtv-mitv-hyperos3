<?xml version="1.0" encoding="utf-8"?>
<!-- Today's weight, waiting to be changed: a soft slab so the number reads as something you can edit.
     The focused state is habit_weight_input_bg_focused: the same slab with a lit edge, since this is
     the one thing on the page that answers up and down. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#331C3324" />
    <corners android:radius="8dp" />
</shape>
